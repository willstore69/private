#!/bin/bash
BASHDIR=/root/xbash/./bash-5.2.37
XBASH=/usr/bin/xbash
ELFREVGO_COMMAND="/usr/bin/elfrevgo"
ELFREVGO_OPTIONS_TEMPLATE="-f %INPUT_ELF% -o %OUTPUT_ELF% -n -t"
UPX_COMMAND="upx"
UPX_OPTIONS="--best"
BINCRYPTER_COMMAND="bincrypter"

progressBar() {
    local current_step=$1
    local total_steps=$2
    local action_text="$3"
    local percentage=$((current_step * 100 / total_steps))
    local bar_width=40
    local filled_width=$((current_step * bar_width / total_steps))
    local bar=""
    for i in $(seq 1 $bar_width); do
        if [ $i -le $filled_width ]; then
            bar="${bar}#"
        else
            bar="${bar}-"
        fi
    done
    echo -ne "Proses: [${bar}] ${percentage}% - ${action_text}...\r"
}

chmod +x /root/v1/*.sh >/dev/null 2>&1
dos2unix /root/v1/*.sh >/dev/null 2>&1

TOTAL_MAJOR_STEPS=8

for file in /root/v1/*.sh; do
    [ -f "$file" ] || continue
    echo "-----------------------------------------------------"
    echo "Memproses: $file"
    echo "-----------------------------------------------------"
    
    current_major_step=0

    ((current_major_step++))
    progressBar $current_major_step $TOTAL_MAJOR_STEPS "Persiapan file awal"
    chmod +x "$file" >/dev/null 2>&1
    dos2unix "$file" >/dev/null 2>&1
    
    ORIGINAL_BASH_FILE="$file"
    FILE_TO_XBASH="$ORIGINAL_BASH_FILE"
    XBASH_OUTPUT_C_FILE="$ORIGINAL_BASH_FILE.c"

    ((current_major_step++))
    progressBar $current_major_step $TOTAL_MAJOR_STEPS "Menjalankan xbash"
    $XBASH "$FILE_TO_XBASH" >/dev/null 2>&1
    GENERATED_C_FILE_FROM_XBASH="$FILE_TO_XBASH.c"
    XBASH_STATUS=$?
    if [ $XBASH_STATUS -ne 0 ]; then
        echo -e "\n⚠️ Gagal menjalankan xbash pada $FILE_TO_XBASH. Melewati file ini."
        continue
    fi
    if [ ! -f "$GENERATED_C_FILE_FROM_XBASH" ]; then
        echo -e "\n⚠️ File C tidak ditemukan setelah menjalankan xbash ($GENERATED_C_FILE_FROM_XBASH). Melewati file ini."
        continue
    fi
    if [ "$GENERATED_C_FILE_FROM_XBASH" != "$XBASH_OUTPUT_C_FILE" ]; then
        mv "$GENERATED_C_FILE_FROM_XBASH" "$XBASH_OUTPUT_C_FILE" >/dev/null 2>&1
    fi

    ((current_major_step++))
    progressBar $current_major_step $TOTAL_MAJOR_STEPS "Kompilasi (make)"
    cp "$XBASH_OUTPUT_C_FILE" "$BASHDIR/shell.c" >/dev/null 2>&1
    CURRENT_DIR=$(pwd)
    cd "$BASHDIR" || { echo -e "\n⚠️ Gagal pindah ke direktori $BASHDIR. Melewati file ini."; cd "$CURRENT_DIR"; rm -f "$XBASH_OUTPUT_C_FILE"; continue; }
    make -j$(nproc) >/dev/null 2>&1
    MAKE_STATUS=$?
    cd "$CURRENT_DIR" || { echo -e "\n⚠️ Gagal kembali ke direktori asal. Menghentikan skrip."; exit 1; }
    if [ $MAKE_STATUS -ne 0 ]; then
        echo -e "\n⚠️ Perintah 'make' gagal untuk $file. Melewati file ini."
        rm -f "$XBASH_OUTPUT_C_FILE"
        continue
    fi
    if [ ! -f "$BASHDIR/bash" ]; then
        echo -e "\n⚠️ File $BASHDIR/bash tidak ditemukan setelah 'make'. Melewati file ini."
        rm -f "$XBASH_OUTPUT_C_FILE"
        continue
    fi
    rm -f "$XBASH_OUTPUT_C_FILE"

    ((current_major_step++))
    EXECUTABLE_TEMP_NAME="$file.x"
    progressBar $current_major_step $TOTAL_MAJOR_STEPS "Post-compile & strip"
    cp "$BASHDIR/bash" "$EXECUTABLE_TEMP_NAME" >/dev/null 2>&1
    strip "$EXECUTABLE_TEMP_NAME" >/dev/null 2>&1

    ((current_major_step++))
    progressBar $current_major_step $TOTAL_MAJOR_STEPS "Proteksi ELF (elfrevgo)"
    ELF_OBFUSCATED_TEMP_NAME="$EXECUTABLE_TEMP_NAME.revgo"
    CURRENT_ELFREVGO_OPTIONS=$(echo "$ELFREVGO_OPTIONS_TEMPLATE" | sed "s|%INPUT_ELF%|$EXECUTABLE_TEMP_NAME|g; s|%OUTPUT_ELF%|$ELF_OBFUSCATED_TEMP_NAME|g")
    $ELFREVGO_COMMAND $CURRENT_ELFREVGO_OPTIONS >/dev/null 2>&1
    ELFREVGO_STATUS=$?
    if [ $ELFREVGO_STATUS -eq 0 ] && [ -f "$ELF_OBFUSCATED_TEMP_NAME" ] && [ -s "$ELF_OBFUSCATED_TEMP_NAME" ] && [ "$ELF_OBFUSCATED_TEMP_NAME" != "$EXECUTABLE_TEMP_NAME" ]; then
        mv "$ELF_OBFUSCATED_TEMP_NAME" "$EXECUTABLE_TEMP_NAME" >/dev/null 2>&1
    elif [ $ELFREVGO_STATUS -eq 0 ] && [ "$ELF_OBFUSCATED_TEMP_NAME" = "$EXECUTABLE_TEMP_NAME" ]; then
        :
    else
        echo -e "\n⚠️ Gagal mengobfuskasi dengan ELFREVGO (status: $ELFREVGO_STATUS) atau output kosong. Melanjutkan dengan versi strip."
        [ -f "$ELF_OBFUSCATED_TEMP_NAME" ] && [ "$ELF_OBFUSCATED_TEMP_NAME" != "$EXECUTABLE_TEMP_NAME" ] && rm -f "$ELF_OBFUSCATED_TEMP_NAME"
    fi

    ((current_major_step++))
    progressBar $current_major_step $TOTAL_MAJOR_STEPS "Kompresi (UPX)"
    if command -v "$UPX_COMMAND" &> /dev/null; then
        $UPX_COMMAND $UPX_OPTIONS "$EXECUTABLE_TEMP_NAME" >/dev/null 2>&1
        UPX_STATUS=$?
        if [ $UPX_STATUS -ne 0 ]; then
            echo -e "\n⚠️ UPX gagal memproses $EXECUTABLE_TEMP_NAME (status: $UPX_STATUS)."
        fi
    else
        echo -e "\n⚠️ Perintah UPX '$UPX_COMMAND' tidak ditemukan. Melewatkan kompresi UPX."
    fi

    ((current_major_step++))
    progressBar $current_major_step $TOTAL_MAJOR_STEPS "Obfuskasi (bincrypter)"
    if command -v "$BINCRYPTER_COMMAND" &> /dev/null; then
        $BINCRYPTER_COMMAND "$EXECUTABLE_TEMP_NAME" >/dev/null 2>&1
        BINCRYPTER_STATUS=$?
        if [ $BINCRYPTER_STATUS -ne 0 ]; then
            echo -e "\n⚠️ bincrypter gagal memproses $EXECUTABLE_TEMP_NAME (status: $BINCRYPTER_STATUS)."
        fi
    else
        echo -e "\n⚠️ Perintah '$BINCRYPTER_COMMAND' tidak ditemukan. Melewatkan obfuskasi bincrypter."
    fi

    ((current_major_step++))
    progressBar $current_major_step $TOTAL_MAJOR_STEPS "Finalisasi"
    rm -f "$BASHDIR/bash"
    mv "$EXECUTABLE_TEMP_NAME" "$file" >/dev/null 2>&1
    
    echo -ne "\n"
    echo "    Selesai memproses $file."
done
echo "====================================================="
echo "✅ Selesai memproses semua file .sh di /root/v1/"
echo "====================================================="
